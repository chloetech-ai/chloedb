 "builder_sql": {
  "per_week": "SELECT date_trunc('week', created_at) AS created_at_week, priority, COUNT(*) AS n\nFROM tickets\nGROUP BY date_trunc('week', created_at), priority\nORDER BY date_trunc('week', created_at), priority\nLIMIT 1000;",
  "median_hours": "SELECT date_trunc('week', created_at) AS created_at_week, MEDIAN(date_diff('minute', created_at, solved_at) / 60.0) AS median_hours_to_solved_at\nFROM tickets\nGROUP BY date_trunc('week', created_at)\nORDER BY date_trunc('week', created_at)\nLIMIT 1000;",
  "top_tags": "SELECT tags, COUNT(*) AS n\nFROM tickets\nGROUP BY tags\nORDER BY n DESC\nLIMIT 10;",
  "satisfaction": "SELECT assignee, satisfaction, ROUND(100.0 * COUNT(*) / SUM(COUNT(*)) OVER (PARTITION BY assignee), 1) AS pct_of_assignee\nFROM tickets\nWHERE satisfaction IN ('good', 'bad')\nGROUP BY assignee, satisfaction\nORDER BY pct_of_assignee DESC\nLIMIT 20;"
