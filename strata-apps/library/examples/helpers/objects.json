   "args": [
    {
     "a": {
      "b": [
       {
        "c": 5
       }
      ]
     }
    },
    "a.b[0].c"
   ],
   "expect": 5
  },
  {
   "call": "get",
   "args": [
    {
     "a": {
      "b": null
     }
    },
