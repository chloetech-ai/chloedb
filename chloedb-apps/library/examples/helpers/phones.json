{
 "cases": [
  {
   "call": "clean",
   "args": [
    " +1 (415) 555-0123 "
   ],
   "expect": "+14155550123"
  },
  {
   "call": "clean",
   "args": [
    "415.555.0123 ext. 42"
   ],
   "expect": "4155550123"
  },
  {
   "call": "format",
   "args": [
    "4155550123"
   ],
   "expect": "(415) 555-0123"
  },
  {
   "call": "format",
   "args": [
    "+44 (0)20 7946 0958"
   ],
   "expect": "+44 20 7946 0958"
  },
  {
   "call": "format",
   "args": [
    "0033 1 23 45 67 89",
    {
     "country": "DE"
    }
   ],
   "expect": "+33 1 23 45 67 89"
  },
  {
   "call": "e164",
   "args": [
    "020 7946 0958",
    "GB"
   ],
   "expect": "+442079460958"
  },
  {
   "call": "e164",
   "args": [
    ""
   ],
   "expect": null
  },
  {
   "call": "isValid",
   "args": [
    "123-4567",
    "US"
   ],
   "expect": false
  },
  {
   "call": "tel",
   "args": [
    "(415) 555-0123"
   ],
   "expect": "tel:+14155550123"
  },
  {
   "call": "mask",
   "args": [
    "+1 415 555 0123"
   ],
   "expect": "•••• 0123"
  }
 ]
}
