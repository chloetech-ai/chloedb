    {
     "holidays": [
      "2026-11-09"
     ]
    }
   ],
   "expect": "2026-11-10"
  },
  {
   "call": "addBusinessDays",
   "args": [
    "2026-11-09",
    -1
   ],
   "expect": "2026-11-06"
  },
  {
   "call": "businessDaysBetween",
   "args": [
